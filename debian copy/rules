#!/usr/bin/make -f

export LC_ALL=C.UTF-8
export LANG=C.UTF-8

export DH_GOLANG_EXCLUDES := iphlpapi
export GO111MODULE=on
export GOFLAGS=-mod=vendor
export GOPROXY=https://proxy.golang.org,direct

%:
	dh $@

override_dh_auto_build:
	mkdir -p .gocache
	@echo "Go version is:"
	@go version
	USE_BROTLI=1 USE_LIBSODIUM=1 USE_LZO=1 GOCACHE=$(CURDIR)/.gocache make deps
	USE_BROTLI=1 USE_LIBSODIUM=1 USE_LZO=1 GOCACHE=$(CURDIR)/.gocache make pg_build
	USE_BROTLI=1 USE_LIBSODIUM=1 USE_LZO=1 GOCACHE=$(CURDIR)/.gocache make mysql_build
	USE_BROTLI=1 USE_LIBSODIUM=1 USE_LZO=1 GOCACHE=$(CURDIR)/.gocache make mongo_build
	USE_BROTLI=1 USE_LIBSODIUM=1 USE_LZO=1 GOCACHE=$(CURDIR)/.gocache make redis_build
	USE_BROTLI=1 USE_LIBSODIUM=1 USE_LZO=1 GOCACHE=$(CURDIR)/.gocache make sqlserver_build
	USE_BROTLI=1 USE_LIBSODIUM=1 USE_LZO=1 GOCACHE=$(CURDIR)/.gocache make fdb_build
	USE_BROTLI=1 USE_LIBSODIUM=1 USE_LZO=1 GOCACHE=$(CURDIR)/.gocache make gp_build	

override_dh_auto_install:
	install -d debian/wal-g/usr/bin
	install -m 0755 main/pg/wal-g debian/wal-g/usr/bin/wal-g
	install -m 0755 main/mysql/wal-g debian/wal-g/usr/bin/wal-g-mysql
	install -m 0755 main/mongo/wal-g debian/wal-g/usr/bin/wal-g-mongo
	install -m 0755 main/redis/wal-g debian/wal-g/usr/bin/wal-g-redis
	install -m 0755 main/sqlserver/wal-g debian/wal-g/usr/bin/wal-g-sqlserver
	install -m 0755 main/fdb/wal-g debian/wal-g/usr/bin/wal-g-fdb
	install -m 0755 main/gp/wal-g debian/wal-g/usr/bin/wal-g-gp

override_dh_auto_clean:
	make clean

override_dh_auto_test:
	true