#!/usr/bin/make -f

export LC_ALL=C.UTF-8
export LANG=C.UTF-8

export DH_GOLANG_EXCLUDES := iphlpapi

%:
	dh $@ --buildsystem=golang --with=golang

override_dh_auto_build:
	USE_BROTLI=1 USE_LIBSODIUM=1 USE_LZO=1 make deps
	USE_BROTLI=1 USE_LIBSODIUM=1 USE_LZO=1 make pg_build
	USE_BROTLI=1 USE_LIBSODIUM=1 USE_LZO=1 make mongo_build
	USE_BROTLI=1 USE_LIBSODIUM=1 USE_LZO=1 make redis_build

override_dh_auto_install:
	# Не используем dh_auto_install, всё руками
	install -d $(CURDIR)/debian/wal-g-pg/usr/bin
	install -d $(CURDIR)/debian/wal-g-mongo/usr/bin
	install -d $(CURDIR)/debian/wal-g-redis/usr/bin
	install -m 0755 main/pg/wal-g $(CURDIR)/debian/wal-g-pg/usr/bin/wal-g
	install -m 0755 main/mongo/wal-g $(CURDIR)/debian/wal-g-mongo/usr/bin/wal-g
	install -m 0755 main/redis/wal-g $(CURDIR)/debian/wal-g-redis/usr/bin/wal-g

override_dh_auto_clean:
	make clean