#!/usr/bin/make -f

export LC_ALL=C.UTF-8
export LANG=C.UTF-8

export DH_GOLANG_EXCLUDES := iphlpapi
export GO111MODULE=on
export GOPROXY=https://proxy.golang.org,direct
export GOCACHE := $(CURDIR)/.gocache
export GOMODCACHE := $(CURDIR)/.gomodcache

%:
	dh $@

override_dh_auto_build:
	mkdir -p $(GOCACHE)
	@echo "Go version is:"
	@go version
	# deps теперь не создаёт vendor, просто инициализирует submodules
	USE_BROTLI=1 USE_LIBSODIUM=1 USE_LZO=1 make deps
	USE_BROTLI=1 USE_LIBSODIUM=1 USE_LZO=1 make pg_build GOFLAGS="-mod=vendor"
	USE_BROTLI=1 USE_LIBSODIUM=1 USE_LZO=1 make mysql_build GOFLAGS="-mod=vendor"
	USE_BROTLI=1 USE_LIBSODIUM=1 USE_LZO=1 make mongo_build GOFLAGS="-mod=vendor"
	USE_BROTLI=1 USE_LIBSODIUM=1 USE_LZO=1 make redis_build GOFLAGS="-mod=vendor"
	USE_BROTLI=1 USE_LIBSODIUM=1 USE_LZO=1 make sqlserver_build GOFLAGS="-mod=vendor"
	USE_BROTLI=1 USE_LIBSODIUM=1 USE_LZO=1 make fdb_build GOFLAGS="-mod=vendor"
	USE_BROTLI=1 USE_LIBSODIUM=1 USE_LZO=1 make gp_build GOFLAGS="-mod=vendor"

override_dh_auto_install:
	install -d debian/wal-g/usr/bin
	install -m 0755 main/pg/wal-g debian/wal-g/usr/bin/wal-g
	install -m 0755 main/mysql/wal-g debian/wal-g/usr/bin/wal-g-mysql
	install -m 0755 main/mongo/wal-g debian/wal-g/usr/bin/wal-g-mongo
	install -m 0755 main/redis/wal-g debian/wal-g/usr/bin/wal-g-redis
	install -m 0755 main/sqlserver/wal-g debian/wal-g/usr/bin/wal-g-sqlserver
	install -m 0755 main/fdb/wal-g debian/wal-g/usr/bin/wal-g-fdb
	install -m 0755 main/gp/wal-g debian/wal-g/usr/bin/wal-g-gp

override_dh_auto_clean:
	make clean

override_dh_auto_test:
	true
